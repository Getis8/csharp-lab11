classDiagram
direction LR
class ICarControl {
  <<interface, Subject>>
  +OpenDoors(string client) CommandResult
  +StartEngine(string client) CommandResult
  +Honk(string client) CommandResult
}
class RemoteCarControl {
  <<Real Subject>>
  -string _plate
  +int ServerCalls
  -Send(string command) CommandResult
}
class CarControlProxy {
  <<Proxy>>
  -ICarControl _real
  -string _plate
  -string _renter
  -List~string~ _journal
  +IReadOnlyList~string~ Journal
  -Execute(string client, string command, Func action) CommandResult
}
class DemoRunner {
  <<Client>>
}
ICarControl <|.. RemoteCarControl
ICarControl <|.. CarControlProxy
CarControlProxy "1" --> "1" ICarControl : _real
DemoRunner ..> ICarControl : uses
